# Opcional. Sin DATABASE_URL se usa PGlite (Postgres embebido) en ./.data/pglite
# DATABASE_URL=postgres://user:pass@localhost:5432/educai

# Opcional. Sin key, el tutor, la evaluación semántica y la generación usan fallbacks deterministas.
# ANTHROPIC_API_KEY=sk-ant-...

# Firma de la cookie de sesión demo. Cambiala en cualquier despliegue compartido.
SESSION_SECRET=educai-dev-secret-change-me

# Habilita "Reiniciar demo" y "Simular participación del aula".
DEMO_MODE=true
